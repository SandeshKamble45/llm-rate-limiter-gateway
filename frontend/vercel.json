{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://llm-rate-limiter-gateway.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://llm-rate-limiter-gateway.onrender.com/actuator/:path*"
    }
  ]
}
